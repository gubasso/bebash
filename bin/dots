#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit 2>/dev/null || true

__dots_bin_source() {
  local src=${BASH_SOURCE[0]}
  while [[ -L "$src" ]]; do
    local dir
    dir=$(cd -P -- "$(dirname -- "$src")" && pwd)
    src=$(readlink -- "$src")
    [[ "$src" != /* ]] && src=$dir/$src
  done
  cd -P -- "$(dirname -- "$src")" && pwd
}

__dots_bin_dir=$(__dots_bin_source)
export __BEBASH_BIN_DIR=${__BEBASH_BIN_DIR:-$__dots_bin_dir}
# Locate the library root in both layouts: installed FHS ($bindir/../lib/bebash)
# and the repo/old-payload tree ($bindir/..). Probe installed first; lib/core.bash
# is the shared sentinel that exists in the payload regardless of entry point.
if [[ -z "${BEBASH_LIB:-}" ]]; then
  for __dots_cand in "$__dots_bin_dir/../lib/bebash" "$__dots_bin_dir/.."; do
    [[ -r "$__dots_cand/lib/core.bash" ]] && {
      BEBASH_LIB=$(cd -P -- "$__dots_cand" && pwd)
      break
    }
  done
  : "${BEBASH_LIB:?dots: cannot locate bebash library root}"
  export BEBASH_LIB
  unset __dots_cand
fi
BEBASH_CONFIG_DIR=${BEBASH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/bebash}
BEBASH_DATA_DIR=${BEBASH_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/bebash}
export BEBASH_CONFIG_DIR BEBASH_DATA_DIR

# shellcheck source=lib/log.bash
source "$BEBASH_LIB/lib/log.bash"
# shellcheck source=lib/ui.bash
source "$BEBASH_LIB/lib/ui.bash"
# shellcheck source=lib/helpers.bash
source "$BEBASH_LIB/lib/helpers.bash"
# shellcheck source=lib/dots.bash
source "$BEBASH_LIB/lib/dots.bash"

dots::main "$@"
